{
  "name": "schema-bridge",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @schemabridge/shared-types && npm run build -w @schemabridge/schema-parser && npm run build -w @schemabridge/transformation-engine && npm run build -w @schemabridge/backend && npm run build -w @schemabridge/control-plane && npm run build -w @schemabridge/frontend",
    "dev": "npm run dev -w @schemabridge/frontend",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "db:generate": "npm run prisma:generate -w @schemabridge/backend",
    "db:migrate": "npm run prisma:migrate -w @schemabridge/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^3.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.9.0",
    "@vitejs/plugin-react": "^4.5.1",
    "clsx": "^2.1.1",
    "fastify": "^5.3.3",
    "lucide-react": "^0.511.0",
    "prisma": "^6.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "zod": "^3.25.56",
    "zustand": "^5.0.5"
  }
}
