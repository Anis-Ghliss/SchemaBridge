generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchemaDocument {
  id        String   @id @default(uuid())
  name      String
  content   Json
  fields    Json
  createdAt DateTime @default(now())

  sourceMappings Mapping[] @relation("SourceSchema")
  targetMappings Mapping[] @relation("TargetSchema")
}

model Mapping {
  id               String           @id @default(uuid())
  name             String
  sourceSchemaId   String
  targetSchemaId   String
  currentVersion   Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  sourceSchema     SchemaDocument   @relation("SourceSchema", fields: [sourceSchemaId], references: [id], onDelete: Cascade)
  targetSchema     SchemaDocument   @relation("TargetSchema", fields: [targetSchemaId], references: [id], onDelete: Cascade)
  versions         MappingVersion[]
  requestBindings  ProxyBinding[]   @relation("RequestMapping")
  responseBindings ProxyBinding[]   @relation("ResponseMapping")
}

model MappingVersion {
  id        String   @id @default(uuid())
  mappingId String
  version   Int
  rules     Json
  createdAt DateTime @default(now())
  mapping   Mapping  @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, version])
}

model ProxyBinding {
  id                String   @id @default(uuid())
  name              String
  method            String
  pathPattern       String
  upstreamBaseUrl   String
  mappingId         String
  responseMappingId String?
  forwardHeaders    Json
  validationMode    String   @default("off")
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  mapping           Mapping  @relation("RequestMapping", fields: [mappingId], references: [id], onDelete: Restrict)
  responseMapping   Mapping? @relation("ResponseMapping", fields: [responseMappingId], references: [id], onDelete: SetNull)
  requests          ProxyRequestLog[]
  driftEvents       DriftEvent[]
}

model DriftEvent {
  id           String       @id @default(uuid())
  bindingId    String
  stage        String
  kind         String
  path         String
  expectedType String?
  observedType String?
  count        Int          @default(1)
  firstSeenAt  DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  binding      ProxyBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, stage, kind, path])
  @@index([bindingId])
  @@index([lastSeenAt])
}

model ProxyRequestLog {
  id                 String        @id @default(uuid())
  bindingId          String?
  appId              String?
  method             String
  path               String
  statusCode         Int
  durationMs         Int
  upstreamUrl        String?
  incomingRequest    Json?
  transformedRequest Json?
  responseBody       Json?
  errors             Json
  createdAt          DateTime      @default(now())
  binding            ProxyBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)
  app                ProxyApp?     @relation(fields: [appId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model ProxyApp {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  keyHash     String   @unique
  keyPrefix   String
  scope       String
  bindingIds  Json
  enabled     Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requests    ProxyRequestLog[]

  @@index([keyHash])
}
