{
  "name": "@schemabridge/backend",
  "version": "0.1.3",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.9.0",
    "@schemabridge/schema-parser": "0.1.3",
    "@schemabridge/shared-types": "0.1.3",
    "@schemabridge/transformation-engine": "0.1.3",
    "fastify": "^5.3.3",
    "path-to-regexp": "^8.2.0",
    "undici": "^7.10.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
